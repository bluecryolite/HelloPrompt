# GitHub Fine-grained token with the "Copilot Requests" permission.
# Keep the real value in .env and never commit that file.
COPILOT_GITHUB_TOKEN=github_pat_your_token_here

# Optional: use a specific model returned by the Copilot SDK.
# COPILOT_MODEL=your-available-model

# Optional: hello-world016 model request timeout in milliseconds (default: 60000).
# HELLO_WORLD_REQUEST_TIMEOUT_MS=60000

# Optional: upload LangChain traces to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hello-world016

# Optional: isolated directory for Copilot SDK session state (defaults to .copilot).
# COPILOT_DATA_DIRECTORY=/var/lib/helloprompt/copilot

# Optional: application port (defaults to 30001).
# PORT=30001

# Set to true only when running behind a trusted reverse proxy.
# TRUST_PROXY=true

# Browser Kokoro assets. The model root is served by this app from public/.
# Recommended directory: public/models/kokoro/Kokoro-82M/
# VITE_KOKORO_ASSET_BASE_URL=/models/kokoro/
# VITE_KOKORO_MODEL_ID=Kokoro-82M
# Optional quantization override: q8, q4, q4f16, fp16, or fp32.
# VITE_KOKORO_DTYPE=q8

# Browser Whisper assets. The model root is served by this app from public/.
# Recommended directory: public/models/whisper/Xenova/whisper-small.en/
# VITE_WHISPER_ASSET_BASE_URL=/models/whisper/
# VITE_WHISPER_MODEL_ID=Xenova/whisper-small.en
# Optional quantization override: q8, q4, q4f16, fp16, or fp32.
# VITE_WHISPER_DTYPE=q8
